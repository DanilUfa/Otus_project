      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, code) (increase(http_requests_received_total{job=~\"vacation-.*\",service!=\"\",service=~\"api|gateway|audit|reporting\",endpoint!=\"/metrics\",action!=\"/metrics\"}[$__range]))",
          "legendFormat": "{{service}} · {{code}}",
          "datasource": {
