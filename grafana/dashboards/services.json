      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(http_requests_received_total{job=~\"vacation-.*\",service!=\"\",service=~\"api|gateway|audit|reporting\",endpoint!=\"/metrics\",action!=\"/metrics\",code=~\"4..\"}[$__rate_interval])) or on(service) (0 * up{job=~\"vacation-.*\",service!=\"\",service=~\"api|gateway|audit|reporting\"})",
          "legendFormat": "{{service}}",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
